    "odt001": {
      "stable_id": "odt001",
      "source_sha256": "b03b94bae595417e792f89825e7223935271c8c484b8afeb458fefbfea68e172",
      "source_bytes": 366680,
      "title_ko": "어깨 질환",
      "title_en": "Shoulder Disease",
      "edition": "1판",
      "native_review_status": "SOURCE_MIGRATED_EVIDENCE_REFRESH_PENDING",
      "audio_status": "MIGRATION_PENDING_SOURCE_MP4_NOT_INCLUDED_IN_ARCHIVE",
      "chapter_count": 10,
      "figure_count": 9,
      "reference_count": 10,
      "chapters": [
        {
          "id": "odt001-s0",
          "order": 0,
          "title": "어깨 질환의 큰 그림 — 나이, 운동범위, red flag",
          "summary": "나이·수동 운동범위·위험 신호로 첫 방향을 잡습니다.",
          "paragraphs": [
            "회전근개 질환, 동결견, 석회성 건염이 흔한 큰 줄기이며 관절염·신경병증·연관통이 섞입니다.",
            "환자가 스스로 못 움직여도 수동 운동범위가 보존되면 힘줄·근력·신경 문제를 더 생각합니다. 수동 외회전까지 제한되면 동결견·관절염뿐 아니라 놓친 후방 탈구 같은 구조적 원인을 영상과 함께 확인합니다.",
            "발열과 급성 종창, 체중감소와 지속 야간통, 운동과 연동되는 비기계적 왼쪽 어깨 통증, 진행하는 광범위 근력저하·감각이상은 red flag입니다."
          ],
          "evidence_ref_ids": [],
          "cross_links": [],
          "red_flags": [
            "발열·열감·급성 종창",
            "체중감소와 비기계적 지속 야간통",
            "운동과 연동되는 왼쪽 어깨 통증",
            "진행하는 광범위 근력저하·감각이상"
          ],
          "clinical_takeaways": []
        },
        {
          "id": "odt001-s1",
          "order": 1,
          "title": "Rotator cuff disease — tendinopathy에서 파열까지",
          "summary": "건병증부터 전층 파열·cuff tear arthropathy까지 연속선으로 보고 영상과 증상을 맞춰 해석합니다.",
          "paragraphs": [
            "회전근개는 supraspinatus, infraspinatus, teres minor, subscapularis가 상완골두를 안정시키는 구조이며 supraspinatus가 흔히 문제됩니다.",
            "CSAW와 FIMPACT 위약수술 비교 연구는 단순 기계적 impingement 모델을 재평가하게 했습니다. 통증을 견봉 아래 공간 하나로 설명하기보다 힘줄 부하능력·퇴행·기능을 함께 봅니다.",
            "무증상 회전근개 파열은 특히 고령에서 흔합니다. MRI나 초음파에서 파열이 보인다는 사실만으로 현재 통증의 원인이나 수술 적응증을 확정하지 않습니다.",
            "고령의 비외상성 파열은 보존치료로 시작할 수 있지만, 젊은 환자의 명확한 외상 후 급성 근력저하·급성 파열은 조기 수술 평가가 중요할 수 있습니다."
          ],
          "evidence_ref_ids": [
            "odt_ref_001",
            "odt_ref_002",
            "odt_ref_003",
            "odt_ref_004",
            "odt_ref_005"
          ],
          "cross_links": [
